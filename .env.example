API_ID=tu_api_id
API_HASH=tu_api_hash
# Canal/grupo VIP que lee la sesión lectora (tu cuenta personal)
CANAL_ORIGEN=-100xxxxxxxxxx
# Grupo donde publica el bot (el bot debe ser admin ahí)
CANAL_DESTINO=-100xxxxxxxxxx
# Token del bot publicador, de @BotFather
BOT_TOKEN=123456:ABC...
# Sesión lectora: SESSION_STRING (Railway) o PHONE_NUMBER (local, pide código)
SESSION_STRING=valor_generado_por_nueva_sesion.py
PHONE_NUMBER=+34xxxxxxxxx
# Opcional: al arrancar publica las últimas N señales del origen (0 o vacío = no)
PUBLICAR_ULTIMAS=0
